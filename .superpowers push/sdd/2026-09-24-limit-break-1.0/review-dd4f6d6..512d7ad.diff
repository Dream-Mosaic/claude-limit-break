+  const files = {
+    [path.posix.join(CWD, '.claude', 'settings.local.json')]: JSON.stringify({ autoContinueAtUsageLimit: false }),
+    [path.posix.join(CWD, '.claude', 'settings.json')]: JSON.stringify({ autoContinueAtUsageLimit: true }),
+  };
