+  assert.equal(s.list()[0]?.cause, 'stall');
+});
+
+test('the icon is circle-slash', () => {
+  // Pinned (controller ruling 4). See the comment on GAVE_UP_ICON for why
+  // this one and not $(warning) or $(error).
